# Required for all /v1/* requests; /healthz remains anonymous.
# Use the same high-entropy, server-only value in Next.js. Callers must send it
# in X-Selfweb-Proxy-Token. Never commit the real value or expose it as NEXT_PUBLIC_*.
GO_API_PROXY_TOKEN=replace-with-a-long-random-server-only-token

# 与 Next.js CONTENT_SOURCE 及 Sanity 项目配置保持一致。
# 默认每次聊天读取已发布的文章和随心；local 仅用于明确使用本地内容的站点。
CONTENT_SOURCE=sanity
SANITY_PROJECT_ID=rnbye9v9
SANITY_DATASET=production
