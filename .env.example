# Sanity 的项目与数据集标识可以公开；令牌不要提交到仓库。
CONTENT_SOURCE=sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=rnbye9v9
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-22

# 仅执行 scripts/migrate-markdown-to-sanity.mjs --commit 时需要。
SANITY_API_WRITE_TOKEN=

# 在 Sanity webhook 的 Authorization 请求头中配置为：Bearer <此值>
SANITY_REVALIDATE_SECRET=

# 首页（/ 与 /en）浏览量。URL 与 Token 必须成对来自同一个数据库；两者均只留在服务端。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 旧版 Vercel KV 环境变量也受支持。只配置一套完整凭证，代码不会跨套拼接 URL/Token。
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 同一浏览器再次打开首页的最短计数间隔，默认 1800 秒（30 分钟）。
SITE_VIEWS_DEDUP_SECONDS=1800

# 站长排除令牌：部署后，自己在浏览器打开一次
# https://www.iuyup.com/#site-views-owner=<此令牌>
# 即会写入一年有效的私密排除标记；不要把令牌分享给别人。
SITE_VIEWS_OWNER_TOKEN=

# 聊天和留言板的 Go 网关。与 Go 服务使用相同的私密代理令牌。
GO_API_BASE_URL=http://localhost:8080
GO_API_PROXY_TOKEN=
# 仅在可信入口会清理并重写转发头时开启。
TRUST_X_FORWARDED_FOR=false
OPENWEATHERMAP_API_KEY=
